 name="pause">Pause</string><string name="resume">Resume</string><string name="back">Back</string><string name="unload_model">Unload model from memory</string><string name="paused">Paused</string><string name="downloading">Downloading</string><string name="no_results_found">No results found</string><string name="loading_models">Loading models…</string><string name="hugging_face">Hugging Face</string><string name="provider_openai">OpenAI</string><string name="provider_anthropic">Anthropic</string><string name="provider_ollama">Ollama</string><string name="provider_lm_studio">LM Studio</string><string name="provider_custom">Custom</string><string name="provider_local">Local (legacy)</string><string name="provider_lite_rt_lm">LiteRT-LM</string><string name="wizard_skip">Skip</string><string name="wizard_skip_all">Skip all</string><string name="wizard_close">Close</string><string name="wizard_close_wizard">Close wizard</string><string name="wizard_done">Done</string><string name="wizard_next">Next</string><string name="wizard_revisar">Review</string><string name="wizard_back">Back</string><string name="wizard_skip_confirm_title">Skip wizard</string><string name="wizard_skip_confirm_text">Skip the onboarding wizard? You can re-open it anytime from Settings.</string><string name="wizard_close_confirm_title">Close wizard</string><string name="wizard_close_confirm_text">Close the wizard? You can re-open it anytime from Settings.</string><string name="wizard_exit_title">Exit Warped?</string><string name="wizard_exit_text">The wizard will continue next time you open the app.</string><string name="wizard_exit">Exit</string><string name="wizard_cancel">Cancel</string><string name="settings_wizard_title">Setup Wizard</string><string name="settings_wizard_desc">Re-run the onboarding wizard to explore Warped features.</string><string name="settings_wizard_run">Run</string><string name="wizard_step_1_title">Welcome to Warped</string><string name="wizard_step_2_title">Local Engines<