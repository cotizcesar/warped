    <!-- Help -->
    <string name="help_title">Help</string>
    <string name="help_how_to">How to Use Warped</string>
    <string name="help_intro">Run and chat with any LLM — local or remote — from a single Android app.</string>
    <string name="help_s1_title">1. Download a Model</string>
    <string name="help_s1_step1">Open Models from the drawer and tap + to browse the catalog.</string>
    <string name="help_s1_step2">The catalog lists models smallest-first, split into Downloaded and Available.</string>
    <string name="help_s1_step3">Tap any card to see its details and capabilities.</string>
    <string name="help_s1_step4">Tap the download arrow on the model you want.</string>
    <string name="help_s1_step5">Track progress in the card — pause, resume, or cancel there.</string>
    <string name="help_s1_step6">Tap Use in chat on a downloaded card to start chatting with it.</string>
    <string name="help_s1_step7">Delete a downloaded model anytime with the red trash icon.</string>
    <string name="help_s2_title">2. Chat with a Local Model</string>
    <string name="help_s2_step1">Pick a model from the chat top bar, or just start typing.</string>
    <string name="help_s2_step2">Type a message and tap send.</string>
    <string name="help_s2_step3">The model loads on first use — large models take a few seconds.</string>
    <string name="help_s2_step4">GPU acceleration is automatic for supported models.</string>
    <string name="help_s2_step5">Switching models unloads the previous one automatically.</string>
    <string name="help_s3_title">3. Connect to Remote LLMs</string>
    <string name="help_s3_step1">Open Models from the drawer to add a server.</string>
    <string name="help_s3_step2">Supported: OpenAI-compatible APIs, Ollama, LM Studio, Anthropic, and custom servers.</string>
    <string name="help_s3_step3">Enter the server URL and choose the model to use.</string>
    <string name="help_s3_step4">Pick your remote model from the chat dropdown (Net badge).</string>
    <string name="help_s3_step5">Remote replies stream in real time.</string>
    <string name="help_s4_title">4. Vision (Image Input)</string>
    <string name="help_s4_step1">The image button appears only on vision-capable models.</string>
    <string name="help_s4_step2">Check each card\'s capability table for vision support.</string>
    <string name="help_s4_step3">Text-only models hide the image button.</string>
    <string name="help_s4_step4">Previews appear above the input — tap X to remove.</string>
    <string name="help_s5_title">5. Model Capabilities</string>
    <string name="help_s5_step1">Every model handles text in and out.</string>
    <string name="help_s5_step2">Vision, Audio, Thinking, and Tools vary per model — check the card.</string>
    <string name="help_s5_step3">Unsupported buttons stay hidden in chat.</string>
    <string name="help_s5_step4">Collapsed cards show the same flags as icon badges.</string>
    <string name="help_s6_title">6. Tool Calling</string>
    <string name="help_s6_step1">The app does not run tools automatically.</string>
    <string name="help_s6_step2">Badges show model support only, not live tool use.</string>
    <string name="help_s6_step3">If a model supports thinking, enable it from the chat bar.</string>
    <string name="help_s6_step4">Ask anything — the model answers from its own knowledge.</string>
    <string name="help_s6_step5">Enable web grounding when you need current information.</string>
    <string name="help_s7_title">7. Web Grounding</string>
    <string name="help_s7_step1">Paste links into a message to ground the answer in those pages.</string>
    <string name="help_s7_step2">Tap any source in the strip to preview it.</string>
    <string name="help_s7_step3">Turn off web grounding in Settings for a model-only reply.</string>
    <string name="help_s7_step4">Offline sends queue up — tap Retry when back online.</string>
    <string name="help_s7_step5">Web grounding adds cited search results — no setup needed.</string>
    <string name="help_s8_title">8. Tips &amp; Shortcuts</string>
    <string name="help_s8_step1">Tap send to reply; drafts stay in the input.</string>
    <string name="help_s8_step2">You can save generation settings as Presets.</string>
    <string name="help_s8_step3">Tap a model card for its full capability table.</string>
    <string name="help_s8_step4">Delete chats from Recents with the X on each row.</string>
    <string name="help_s8_step5">History stays on your device — nothing goes to the cloud.</string>
    <string name="help_s8_step6">Models live in app-private storage.</string>
</resources>
