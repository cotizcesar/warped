<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Warped.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Warped</item>
    </style>

    <style name="Theme.Warped" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <!-- Edge-to-edge is enabled in code (MainActivity.enableEdgeToEdge);
             android:statusBarColor / android:navigationBarColor theme attrs are
             deprecated on API 35+ (applied via Window.setStatusBarColor /
             setNavigationBarColor) — intentionally absent. -->
    </style>
</resources>
